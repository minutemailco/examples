# Demo app
PORT=3000
BASE_URL=http://localhost:3000

# MinuteMail API (used to deliver verification emails into mailboxes)
MINUTEMAIL_API_BASE=https://api.minutemail.co
MINUTEMAIL_API_KEY=mmak_XXXX

# Mock identity provider (MinuteMail IdP)
OAUTH_ISSUER=https://idp.minutemail.co

# Client 1: custom IdP — email verification enforced, custom claims issued
OAUTH_CUSTOM_CLIENT_ID=mc_XXXX
OAUTH_CUSTOM_CLIENT_SECRET=cs_XXXX

# Client 2: Google — no email verification, fixed claim set
OAUTH_GOOGLE_CLIENT_ID=mc_XXXX
OAUTH_GOOGLE_CLIENT_SECRET=cs_XXXX

OAUTH_REDIRECT_BASE=http://localhost:3000/auth
